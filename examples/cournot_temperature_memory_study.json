    "rounds": 40,
    "revision_probability": 1.0,
    "base_seed": 7,
    "quantity_min": 0.0,
    "quantity_max": 100.0,
    "quantity_step": 0.01,
    "demand_intercept": 100.0,
    "marginal_cost": 1.0,
    "fixed_payment": 150.0
  },
  "execution": {
    "workers": 2,
    "max_concurrent_requests": 2
  }
}
