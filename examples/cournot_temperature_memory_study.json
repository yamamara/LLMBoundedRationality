{
  "name": "llama31-8b-cournot-temperature-memory",
  "provider": {
    "provider": "local_llama",
    "transport": "ollama",
    "endpoint": "http://localhost:11434",
    "model": "llama3.1:8b",
    "max_output_tokens": 300,
    "timeout_seconds": 120.0,
    "max_retries": 2,
    "top_p": 1.0,
    "provider_options": {
      "num_ctx": 16384,
      "keep_alive": "30m"
    }
